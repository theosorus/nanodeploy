# base domain, apps are served at <slug>.<APPS_DOMAIN>
APPS_DOMAIN=apps.example.com

# where app bundles live on the host, put this on real storage, not the SD card
APPS_DIR=/srv/nanodeploy/apps

# generated by install.sh
POSTGRES_PASSWORD=
POCKETID_ENCRYPTION_KEY=
DEPLOY_TOKEN=

# from Pocket ID, admin UI -> OIDC clients -> new client for tinyauth
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# optional, enables the People tab in the dashboard
# Pocket ID admin UI -> API keys -> new key
POCKETID_API_KEY=

# Optional. Only accounts in this group may drive the dashboard; everyone else
# keeps access to the apps themselves. Leave empty and pick the group from the
# People tab instead: the dashboard checks you belong to it before applying,
# which the environment variable cannot do. Setting it here makes it read-only
# in the dashboard.
ADMIN_GROUP=

# host port caddy listens on, point your tunnel or reverse proxy at it
CADDY_PORT=8080

# image versions, pinned so an unattended pull cannot change the platform
# under you. Bump deliberately, then: docker compose up -d
CADDY_VERSION=2.11.4
POCKETID_VERSION=v2.14.0
TINYAUTH_VERSION=v5.1.3
SABLIER_VERSION=1.17.0
POSTGRES_VERSION=16-alpine
SOCKET_PROXY_VERSION=0.3.0
