# Copy to .env or run ./install.sh --init. No secrets belong in this example.
# Full guide: docs/INSTALL.md / docs/INSTALL.fr.md
# Base domain only: no scheme, port or wildcard. Each app has <slug>.<domain>.
APPS_DOMAIN=apps.example.com

# Absolute path on the Docker host. --init defaults to <checkout>/var/apps.
# If using this example path, create it and give the checkout owner write access.
# Use SSD-backed storage for both app files and Docker's data directory.
APPS_DIR=/srv/nanodeploy/apps

# generated by install.sh
POSTGRES_PASSWORD=
DEPLOY_TOKEN=
# the database password of gate, the sign-in service
GATE_DB_PASSWORD=
# encrypts app environments/passwords and forge credentials (64 hex; preserve it)
NANODEPLOY_SECRET_KEY=

# Upgrading from a version that used Pocket ID: start it once with
#   docker compose --profile legacy up -d pocket-id
# and keep its API key and encryption key here. On its first start, the control
# plane imports every account and group with their ids, so no app loses data.
# A fresh install leaves these empty.
POCKETID_API_KEY=
POCKETID_ENCRYPTION_KEY=

# What the browser sees in front of caddy. Leave as is behind a tunnel or a
# reverse proxy terminating TLS; "http" and a port only for a local test stack.
PUBLIC_SCHEME=https
PUBLIC_PORT=
# false only for a localhost HTTP trial; HTTPS always requires true.
COOKIE_SECURE=true

# Analytics count days from midnight in this time zone (e.g. Europe/Paris).
TIMEZONE=UTC

# Caddy binds to 127.0.0.1 on this port. Point the local HTTPS proxy at it.
CADDY_PORT=8080

# Only the actual tunnel/reverse proxy IPs may supply visitor IP headers.
# Add its exact Docker gateway address or dedicated CIDR when needed. Never
# trust every private range: app containers also use private addresses.
TRUSTED_PROXY_CIDRS="127.0.0.1/32 ::1/128"

# Image version tags. Tags can receive upstream patch updates; review upgrades.
# Change deliberately, then run ./install.sh to pull/build/recreate.
CADDY_VERSION=2.11.9
POCKETID_VERSION=v2.14.0
SABLIER_VERSION=1.18.0
POSTGRES_VERSION=16-alpine
HAPROXY_VERSION=3.2.26-alpine

# Optional backups. Default: <parent of APPS_DIR>/backups; last 5 retained.
# BACKUP_DIR=/srv/nanodeploy/backups
# BACKUP_KEEP=5

# Optional automatic updates, enabled only after installing the systemd timer.
# The default checks the public GitHub repository configured as origin.
# UPDATE_BRANCH=main
# GITHUB_API_URL=https://api.github.com
