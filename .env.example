# base domain, apps are served at <slug>.<APPS_DOMAIN>
APPS_DOMAIN=apps.example.com

# where app bundles live on the host, put this on real storage, not the SD card
APPS_DIR=/srv/nanoploy/apps

# generated by install.sh
POSTGRES_PASSWORD=
POCKETID_ENCRYPTION_KEY=
DEPLOY_TOKEN=

# from Pocket ID, admin UI -> OIDC clients -> new client for tinyauth
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# optional, enables the Comptes tab in the dashboard
# Pocket ID admin UI -> API keys -> new key
POCKETID_API_KEY=
