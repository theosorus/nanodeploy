# Boot unit for Nanodeploy.
# Example paths only. Run scripts/configure-systemd.sh to render your actual
# checkout, data directory and user; see docs/INSTALL.md#start-on-boot.
[Unit]
Description=Nanodeploy platform
Requires=docker.service
After=docker.service network-online.target
# Also add Docker's data-root here if you moved it to another mount.
RequiresMountsFor=/opt/nanodeploy /srv/nanodeploy/apps

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nanodeploy
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
