# Boot unit for Nanodeploy.
# Install:
#   sudo cp nanodeploy.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable nanodeploy
# Edit WorkingDirectory and RequiresMountsFor to match your setup.
[Unit]
Description=Nanodeploy platform
Requires=docker.service
After=docker.service network-online.target
# do not start before the external storage holding docker data-root is mounted
RequiresMountsFor=/mnt/ssd

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nanodeploy
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
