{
	# An outer reverse proxy or tunnel terminates TLS; Caddy serves internal HTTP.
	auto_https off
	# The proxy in front terminates TLS and says so with X-Forwarded-Proto.
	# Caddy overwrites that header with its own scheme unless the client is a
	# trusted proxy, so without this the sign-in redirects are built as
	# http:// and drop browsers back to plain http after they sign in.
	servers {
		trusted_proxies static {$TRUSTED_PROXY_CIDRS:127.0.0.1/32 ::1/128}
		trusted_proxies_strict
		# Behind a Cloudflare tunnel every request comes from cloudflared: the
		# visitor's address is in CF-Connecting-IP. Analytics count visitors by
		# it; without this line the whole internet would be one visitor.
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 2m
			idle 30s
		}
	}
	# loopback only: the admin API has no auth, and apps share a network with
	# caddy. The control plane reloads caddy by docker exec, not through this.
	admin localhost:2019
	# identity headers must be stripped BEFORE forward_auth re-injects them.
	# Default order does the opposite, which silently removed the identity from
	# every request that reached an app.
	order request_header before forward_auth
}

# Every access decision is gate's: it reads the app's policy and the caller's
# session or access key from the database and answers 200 (with the identity
# headers when someone is signed in, without when an anonymous visitor may
# pass), a redirect to the sign-in page, 401 or 403. The argument is the app
# slug, or __console for the dashboard.
(nanodeploy_gate) {
	forward_auth gate:4000 {
		uri /verify?app={args[0]}
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups Remote-Sub Remote-Roles Remote-Via
	}
}

# Platform credentials never reach an app backend: gate has read them by the
# time this runs (inside an app's handle, after forward_auth). The host session
# cookie (__Host-nd_s, or nd_s on a plain-http test stack) is bound to this one
# host already; it is removed anyway, the app has no use for it, and neither
# for the short-lived sign-in state (nd_st). tinyauth's cookies are on the list
# for installs upgrading from it. A personal access key (ndk_...) is removed
# too: with it, the app could act as its visitor on every other app. The "; "
# left at the front when the first cookie went is dropped; an app's own cookies
# are kept.
(nanodeploy_hide_session) {
	request_header Cookie "(^|;\s*)((__Host-)?nd_(s|st|root|wa)|tinyauth-[^=;]*)=[^;]*" ""
	request_header Cookie "^;\s*" ""
	request_header Authorization "(?i)^Bearer\s+nd[kd]_.*$" ""
}

# identity headers are gateway-owned, never accept them from a client
(nanodeploy_strip) {
	# Overwrite any client-supplied value; gate uses this single address for its
	# rate limiter instead of the attacker-controlled left end of an XFF list.
	request_header X-Nanodeploy-Client-IP {client_ip}
	request_header -Remote-User
	request_header -Remote-Name
	request_header -Remote-Email
	request_header -Remote-Groups
	request_header -Remote-Sub
	request_header -Remote-Roles
	request_header -Remote-Via
}

# sign-in pages, account page, passkeys: all gate. /verify is the forward-auth
# endpoint and is only meant for caddy itself.
http://auth.{$APPS_DOMAIN} {
	import nanodeploy_strip
	header {
		X-Frame-Options DENY
		-Server
	}
	request_body {
		max_size 64KB
	}
	handle /verify* {
		respond 404
	}
	handle {
		reverse_proxy gate:4000
	}
}

http://deploy.{$APPS_DOMAIN} {
	import nanodeploy_strip
	# the console deploys code and drives docker: never let it be framed, and
	# never leak its url to an app the admin clicks through to
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	request_body {
		max_size 101MB
	}
	# The control plane independently verifies every credential. Caddy only
	# recognizes its syntax, so it no longer needs a copy of the root token.
	@cli header_regexp Authorization ^Bearer\s[A-Za-z0-9_-]{24,128}$
	handle @cli {
		reverse_proxy control-plane:8000
	}
	# per-app deploy keys skip the login too. Caddy cannot know whether a key is
	# valid, only its exact shape: the control plane checks it against the
	# database and answers 401 for anything else, and a key only ever opens the
	# deploy and logs routes of its own app.
	@deploykey header_regexp Authorization ^Bearer\sndd_[A-Za-z0-9_-]{43}$
	handle @deploykey {
		reverse_proxy control-plane:8000
	}
	# GitHub and GitLab webhooks: no session, the control plane checks each
	# delivery's signature or secret token before reading it
	handle /hooks/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy control-plane:8000
	}
	# the sign-in callback of the console's own session
	handle /_nd/* {
		reverse_proxy gate:4000
	}
	# a browser: an administrator who signed in within the last 12 hours
	handle {
		import nanodeploy_gate __console
		reverse_proxy control-plane:8000
	}
}

import /etc/caddy/conf.d/*.caddy

# caddy 2.11 answers 200 empty for hosts it does not know: without this,
# a deleted app or a typo in a subdomain would silently return an empty page
http:// {
	respond "no such app" 404
}
