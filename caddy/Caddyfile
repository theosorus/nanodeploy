{
	# cloudflared terminates TLS, caddy only serves plain http internally
	auto_https off
	# The proxy in front terminates TLS and says so with X-Forwarded-Proto.
	# Caddy overwrites that header with its own scheme unless the client is a
	# trusted proxy, so without this tinyauth builds every login redirect as
	# http:// and drops browsers back to plain http after they sign in.
	servers {
		trusted_proxies static private_ranges
	}
	# loopback only: the admin API has no auth, and apps share a network with
	# caddy. The control plane reloads caddy by docker exec, not through this.
	admin localhost:2019
	# identity headers must be stripped BEFORE forward_auth re-injects them.
	# Default order does the opposite, which silently removed the identity from
	# every request that reached an app.
	order request_header before forward_auth
}

# reusable forward-auth snippet, imported by every private app
(nanodeploy_auth) {
	forward_auth tinyauth:3000 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups Remote-Sub
	}
}

# Platform cookies never reach an app backend. tinyauth names its cookies
# tinyauth-session-<id>, tinyauth-csrf-<id>... on the parent domain, so the
# browser sends them to every app. Used inside an app's handle, after
# forward_auth has read them. The second line drops the "; " left at the front
# when the removed cookie came first; an app's own cookies are kept.
(nanodeploy_hide_session) {
	request_header Cookie "(^|;\s*)tinyauth-[^=;]*=[^;]*" ""
	request_header Cookie "^;\s*" ""
}

# identity headers are gateway-owned, never accept them from a client
(nanodeploy_strip) {
	request_header -Remote-User
	request_header -Remote-Name
	request_header -Remote-Email
	request_header -Remote-Groups
	request_header -Remote-Sub
}

http://auth.{$APPS_DOMAIN} {
	reverse_proxy tinyauth:3000
}

http://id.{$APPS_DOMAIN} {
	reverse_proxy pocket-id:1411
}

http://deploy.{$APPS_DOMAIN} {
	import nanodeploy_strip
	# the console deploys code and drives docker: never let it be framed, and
	# never leak its url to an app the admin clicks through to
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# the CLI authenticates with the exact bearer token, the browser with
	# tinyauth. Matching the literal token (not "Bearer*") closes the bypass
	# where any fake Authorization header skipped the forward-auth. {$DEPLOY_TOKEN}
	# is resolved from the caddy container env: rotate it in .env then
	# "docker compose up -d caddy".
	@cli header Authorization "Bearer {$DEPLOY_TOKEN}"
	handle @cli {
		reverse_proxy control-plane:8000
	}
	# per-app deploy keys skip the login too. Caddy cannot know whether a key is
	# valid, only its exact shape: the control plane checks it against the
	# database and answers 401 for anything else, and a key only ever opens the
	# deploy and logs routes of its own app.
	@deploykey header_regexp Authorization ^Bearer\sndd_[A-Za-z0-9_-]{43}$
	handle @deploykey {
		reverse_proxy control-plane:8000
	}
	handle {
		import nanodeploy_auth
		reverse_proxy control-plane:8000
	}
}

import /etc/caddy/conf.d/*.caddy

# caddy 2.11 answers 200 empty for hosts it does not know: without this,
# a deleted app or a typo in a subdomain would silently return an empty page
http:// {
	respond "no such app" 404
}
